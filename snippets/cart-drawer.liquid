{%- comment -%}
  ============================================================
  Cart Drawer — Slide-in from right
  Soufflo — Shopify AJAX Cart API
  ============================================================
{%- endcomment -%}

{%- comment -%} Overlay backdrop {%- endcomment -%}
<div class="cart-overlay" data-cart-overlay></div>

{%- comment -%} Drawer {%- endcomment -%}
<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="Panier">

  {%- comment -%} Header {%- endcomment -%}
  <div class="cart-drawer__header">
    <h2>Votre panier</h2>
    <button type="button" aria-label="Fermer" data-cart-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  {%- comment -%} Items {%- endcomment -%}
  <div class="cart-drawer__items" data-cart-items>
    <p class="cart-drawer__empty" data-cart-empty>Votre panier est vide.</p>
  </div>

  {%- comment -%} Footer {%- endcomment -%}
  <div class="cart-drawer__footer" data-cart-footer style="display: none;">
    <div class="cart-drawer__row">
      <span>Sous-total</span>
      <span data-cart-subtotal>0,00 &euro;</span>
    </div>
    <div class="cart-drawer__row">
      <span>Livraison</span>
      <span class="cart-drawer__free-shipping">Offerte</span>
    </div>
    <div class="cart-drawer__row cart-drawer__row--total">
      <span>Total</span>
      <span data-cart-total>0,00 &euro;</span>
    </div>
    <a href="/checkout" class="cart-drawer__checkout" data-checkout>Passer commande</a>
    <p class="cart-drawer__reassurance">&#128274; Paiement 100% s&eacute;curis&eacute; &middot; 30j satisfait ou rembours&eacute;</p>
    {% render 'payment-icons' %}
  </div>

</aside>

<script>
(function() {
  var overlay = document.querySelector('[data-cart-overlay]');
  var drawer = document.querySelector('[data-cart-drawer]');
  var itemsContainer = document.querySelector('[data-cart-items]');
  var emptyMsg = document.querySelector('[data-cart-empty]');
  var footer = document.querySelector('[data-cart-footer]');
  var subtotalEl = document.querySelector('[data-cart-subtotal]');
  var totalEl = document.querySelector('[data-cart-total]');

  if (!overlay || !drawer) return;

  /* ---- Open / Close ---- */
  function openCart() {
    overlay.dataset.open = 'true';
    drawer.dataset.open = 'true';
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    fetchCart();
  }

  function closeCart() {
    overlay.dataset.open = 'false';
    drawer.dataset.open = 'false';
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  /* Close buttons */
  document.querySelectorAll('[data-cart-close]').forEach(function(btn) {
    btn.addEventListener('click', closeCart);
  });
  overlay.addEventListener('click', closeCart);

  /* Listen for custom event */
  document.addEventListener('cart:open', openCart);

  /* ---- Format money ---- */
  function formatMoney(cents) {
    var euros = (cents / 100).toFixed(2).replace('.', ',');
    return euros + ' €';
  }

  /* ---- Fetch & render cart ---- */
  function fetchCart() {
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .then(renderCart)
      .catch(function(err) { console.error('Cart fetch error:', err); });
  }

  function renderCart(cart) {
    /* Update header badge */
    updateCartCount(cart.item_count);

    if (cart.item_count === 0) {
      emptyMsg.style.display = '';
      footer.style.display = 'none';
      /* Clear items but keep empty message */
      var items = itemsContainer.querySelectorAll('.cart-item');
      items.forEach(function(el) { el.remove(); });
      return;
    }

    emptyMsg.style.display = 'none';
    footer.style.display = '';

    /* Clear existing items */
    var existing = itemsContainer.querySelectorAll('.cart-item');
    existing.forEach(function(el) { el.remove(); });

    /* Render each item */
    cart.items.forEach(function(item) {
      var div = document.createElement('div');
      div.className = 'cart-item';
      div.innerHTML =
        '<div class="cart-item__image">' + (item.image ? '<img src="' + item.image + '" alt="' + item.product_title + '" width="64" height="64" style="width:100%;height:100%;object-fit:cover;border-radius:0.5rem;">' : '') + '</div>' +
        '<div class="cart-item__details">' +
          '<p class="cart-item__name">' + item.product_title + '</p>' +
          (item.variant_title ? '<p class="cart-item__variant">' + item.variant_title + '</p>' : '') +
          '<p class="cart-item__price">' + formatMoney(item.final_line_price) + '</p>' +
        '</div>' +
        '<button type="button" class="cart-item__remove" data-remove-key="' + item.key + '" aria-label="Supprimer">' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
        '</button>';
      itemsContainer.appendChild(div);
    });

    /* Bind remove buttons */
    itemsContainer.querySelectorAll('[data-remove-key]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        removeItem(btn.getAttribute('data-remove-key'));
      });
    });

    /* Update totals */
    subtotalEl.textContent = formatMoney(cart.total_price);
    totalEl.textContent = formatMoney(cart.total_price);
  }

  /* ---- Remove item ---- */
  function removeItem(key) {
    fetch('/cart/change.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    })
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        renderCart(cart);
      })
      .catch(function(err) { console.error('Remove item error:', err); });
  }

  /* ---- Update cart count badge ---- */
  function updateCartCount(count) {
    document.querySelectorAll('[data-cart-count]').forEach(function(el) {
      el.textContent = count;
      if (count > 0) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  }

  /* Expose globally */
  window.openCart = openCart;
  window.closeCart = closeCart;

  /* Initial fetch for count badge */
  fetchCart();
})();
</script>
