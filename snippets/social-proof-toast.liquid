{%- comment -%}
  ============================================================
  Social Proof Toast — Bottom-left notification popup
  Soufflo — periodic fake recent order notifications
  ============================================================
{%- endcomment -%}

<div class="social-proof-toast" data-social-proof-toast aria-live="polite">
  <img src="{{ 'soufflo-3A-hero-product.jpg' | asset_url }}" alt="Soufflo" width="40" height="40" class="social-proof-toast__icon" style="border-radius:0.5rem;object-fit:cover;background:none;">
  <div class="social-proof-toast__text">
    <p class="social-proof-toast__name" data-toast-name style="margin:0;"></p>
    <p class="social-proof-toast__time" data-toast-message style="margin:0;"></p>
  </div>
  <button type="button" class="social-proof-toast__close" data-toast-close aria-label="Fermer">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<script>
(function() {
  var proofs = [
    { name: 'Sophie', city: 'Lyon', pack: 'Pack Duo', timeAgo: '2 min' },
    { name: 'Marc', city: 'Paris', pack: 'Pack Essentiel', timeAgo: '5 min' },
    { name: 'Camille', city: 'Marseille', pack: 'Pack Maison', timeAgo: '8 min' },
    { name: 'Thomas', city: 'Bordeaux', pack: 'Pack Duo', timeAgo: '11 min' },
    { name: 'Léa', city: 'Toulouse', pack: 'Pack Essentiel', timeAgo: '14 min' },
    { name: 'Antoine', city: 'Nice', pack: 'Pack Duo', timeAgo: '17 min' },
    { name: 'Julie', city: 'Nantes', pack: 'Pack Maison', timeAgo: '20 min' },
    { name: 'Maxime', city: 'Strasbourg', pack: 'Pack Essentiel', timeAgo: '24 min' },
    { name: 'Nathalie', city: 'Lille', pack: 'Pack Duo', timeAgo: '28 min' },
    { name: 'Pierre', city: 'Montpellier', pack: 'Pack Maison', timeAgo: '32 min' }
  ];

  var toast = document.querySelector('[data-social-proof-toast]');
  if (!toast) return;

  var nameEl = toast.querySelector('[data-toast-name]');
  var msgEl = toast.querySelector('[data-toast-message]');
  var closeBtn = toast.querySelector('[data-toast-close]');
  var current = 0;
  var dismissed = false;
  var showTimer = null;
  var hideTimer = null;

  function show(item) {
    if (dismissed) return;
    nameEl.textContent = item.name + ' — ' + item.city;
    msgEl.textContent = 'vient de commander le ' + item.pack + ' · il y a ' + item.timeAgo;
    toast.classList.add('is-visible');
  }

  function hide() {
    toast.classList.remove('is-visible');
  }

  function scheduleNext() {
    var delay = 30000 + Math.floor(Math.random() * 15000); /* 30-45s */
    showTimer = setTimeout(function() {
      current = (current + 1) % proofs.length;
      show(proofs[current]);
      hideTimer = setTimeout(hide, 4000);
      scheduleNext();
    }, delay);
  }

  /* Close permanently */
  if (closeBtn) {
    closeBtn.addEventListener('click', function() {
      dismissed = true;
      hide();
      clearTimeout(showTimer);
      clearTimeout(hideTimer);
    });
  }

  /* First show after 12s */
  setTimeout(function() {
    show(proofs[0]);
    hideTimer = setTimeout(hide, 4000);
    scheduleNext();
  }, 12000);
})();
</script>
