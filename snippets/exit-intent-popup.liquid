{%- comment -%}
  ============================================================
  Exit Intent Popup — Soufflo
  -10% code FRAIS10, desktop mouse-leave + mobile 30s idle
  Show once per session (sessionStorage)
  ============================================================
{%- endcomment -%}

<div class="exit-popup" data-exit-popup>
  <div class="exit-popup-card">
    <button type="button" class="exit-popup-close" aria-label="Fermer" data-exit-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="exit-popup__emoji">&#127788;&#65039;</div>

    <h3 class="exit-popup__title">Attendez&nbsp;!</h3>

    <p class="exit-popup__text">Profitez de -10% avec le code ci-dessous.</p>

    <div class="exit-code-box">FRAIS10</div>

    <a href="#product-hero" class="exit-popup__cta" data-exit-cta>J'en profite</a>

    <button type="button" class="exit-popup__dismiss" data-exit-close>Non merci</button>
  </div>
</div>

<script>
(function() {
  var popup = document.querySelector('[data-exit-popup]');
  if (!popup) return;

  var STORAGE_KEY = 'soufflo-exit-shown';
  if (sessionStorage.getItem(STORAGE_KEY)) return;

  var shown = false;

  function show() {
    if (shown) return;
    shown = true;
    popup.classList.add('is-open');
    sessionStorage.setItem(STORAGE_KEY, '1');
  }

  function hide() {
    popup.classList.remove('is-open');
  }

  /* Close buttons */
  popup.querySelectorAll('[data-exit-close]').forEach(function(btn) {
    btn.addEventListener('click', hide);
  });

  /* Click on overlay closes */
  popup.addEventListener('click', function(e) {
    if (e.target === popup) hide();
  });

  /* CTA scrolls to hero and closes */
  var cta = popup.querySelector('[data-exit-cta]');
  if (cta) {
    cta.addEventListener('click', function(e) {
      e.preventDefault();
      hide();
      var hero = document.getElementById('product-hero');
      if (hero) hero.scrollIntoView({ behavior: 'smooth' });
    });
  }

  /* Escape closes */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hide();
  });

  /* ---- Desktop: mouse leave top of viewport after 8s ---- */
  var isMobile = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

  if (!isMobile) {
    var armed = false;
    setTimeout(function() { armed = true; }, 8000);

    document.addEventListener('mouseleave', function(e) {
      if (armed && e.clientY < 10) {
        show();
      }
    });
  } else {
    /* ---- Mobile: 30s idle after 4s armed delay ---- */
    var mobileArmed = false;
    setTimeout(function() { mobileArmed = true; }, 4000);

    var idleTimer = null;
    var IDLE_MS = 30000;

    function resetIdle() {
      if (!mobileArmed) return;
      clearTimeout(idleTimer);
      idleTimer = setTimeout(show, IDLE_MS);
    }

    ['scroll', 'touchstart', 'touchmove'].forEach(function(evt) {
      document.addEventListener(evt, resetIdle, { passive: true });
    });

    /* Start idle timer once armed */
    setTimeout(resetIdle, 4000);
  }
})();
</script>
