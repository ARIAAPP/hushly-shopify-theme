{%- comment -%}
  Promo Banner — placeholder for future promotional campaigns.
  Configure dates and code below to activate.
  The visitor can close the banner (localStorage).
{%- endcomment -%}

<div id="PromoBanner" class="promo-banner" style="display:none;" role="banner" aria-label="Promotion">
  <div class="promo-banner__inner">
    <span class="promo-banner__emoji">💨</span>
    <span class="promo-banner__text">
      Offre speciale : <strong>-10%</strong> avec le code
    </span>
    <button type="button" class="promo-banner__code" onclick="navigator.clipboard.writeText('FRAIS10');this.textContent='Copie !';setTimeout(()=>this.textContent='FRAIS10',1500);" title="Cliquer pour copier">FRAIS10</button>
    <span class="promo-banner__sep">&bull;</span>
    <span class="promo-banner__timer" id="PromoCountdown">--j --h --m --s</span>
    <button type="button" class="promo-banner__close" aria-label="Fermer" onclick="document.getElementById('PromoBanner').style.display='none';localStorage.setItem('promo_banner_closed','frais10');">&times;</button>
  </div>
</div>

<style>
  .promo-banner {
    background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 50%, #0C4A6E 100%);
    color: #fff;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.85rem;
    line-height: 1.4;
    position: relative;
    z-index: 9999;
    overflow: hidden;
  }
  .promo-banner__inner {
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding: 0.55rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .promo-banner__emoji {
    font-size: 1.1rem;
  }
  .promo-banner__text {
    white-space: nowrap;
  }
  .promo-banner__text strong {
    font-weight: 800;
  }
  .promo-banner__code {
    background: #fff;
    color: #0C4A6E;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    border: 2px dashed rgba(255,255,255,0.5);
    cursor: pointer;
    font-family: monospace;
    letter-spacing: 0.05em;
    transition: transform 0.15s;
  }
  .promo-banner__code:hover {
    transform: scale(1.06);
  }
  .promo-banner__sep {
    opacity: 0.6;
    font-size: 0.7rem;
  }
  .promo-banner__timer {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .promo-banner__close {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 1.3rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    line-height: 1;
  }
  .promo-banner__close:hover {
    color: #fff;
  }

  @media (max-width: 600px) {
    .promo-banner__inner {
      font-size: 0.78rem;
      padding: 0.5rem 2rem 0.5rem 0.6rem;
      gap: 0.3rem;
    }
    .promo-banner__sep { display: none; }
    .promo-banner__timer {
      width: 100%;
      text-align: center;
      font-size: 0.75rem;
      margin-top: 0.15rem;
    }
  }
</style>

<script>
(function() {
