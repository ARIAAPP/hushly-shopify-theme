{%- comment -%}
  ============================================================
  Scroll to Top — Floating button, bottom-right
  Appears after 800px scroll
  ============================================================
{%- endcomment -%}

<button type="button" class="scroll-to-top" data-scroll-top aria-label="Retour en haut">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
(function() {
  var btn = document.querySelector('[data-scroll-top]');
  if (!btn) return;

  function update() {
    if (window.scrollY > 800) {
      btn.classList.add('is-visible');
    } else {
      btn.classList.remove('is-visible');
    }
  }

  window.addEventListener('scroll', update, { passive: true });
  update();

  btn.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>
