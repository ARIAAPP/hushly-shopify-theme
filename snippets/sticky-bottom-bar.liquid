<div class="sticky-bottom-bar" data-sticky-bar>
  <div class="container flex items-center justify-between gap-4" style="padding: 1rem 0;">
    <div class="flex items-center gap-3" style="min-width:0; flex:1;">
      <div style="height:44px; width:44px; flex-shrink:0; border-radius:10px; background:var(--color-muted); padding:4px; display:flex; align-items:center; justify-content:center;">
        <span style="font-size:1.5rem;">🌙</span>
      </div>
      <div class="sticky-bar-text" style="min-width:0; flex:1;">
        <p class="sticky-bar-title" style="font-size:0.8rem; font-weight:600; line-height:1.15; margin:0 0 4px 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">Bandeau sommeil Hushly</p>
        <div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;">
          <span style="font-size:0.95rem; font-weight:700; color:var(--color-primary);" data-sticky-price>&euro;34,90</span>
          <span style="font-size:0.7rem; color:var(--color-accent); font-weight:600;">Offre de lancement</span>
        </div>
      </div>
    </div>
    <a href="#product" class="sticky-bar-cta" style="background:var(--color-primary); color:var(--color-primary-fg, #fff); border:0; cursor:pointer; text-transform:none; font-weight:700; border-radius:9999px; padding:0.6rem 1.25rem; font-size:0.85rem; flex-shrink:0; white-space:nowrap; text-decoration:none;">Commander</a>
  </div>
</div>

<script>
(function() {
  const bar = document.querySelector('[data-sticky-bar]');
  if (!bar) return;

  function update() {
    const drawerOpen = document.querySelector('[data-cart-drawer]')?.getAttribute('data-open') === 'true';
    const shouldShow = window.scrollY > 600 && !drawerOpen;
    bar.dataset.visible = shouldShow ? 'true' : 'false';
  }
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  document.addEventListener('hushly:cart-state', update);
  update();
})();
</script>
