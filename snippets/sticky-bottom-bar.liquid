{%- comment -%}
  ============================================================
  Sticky Bottom Bar — Fixed CTA, appears after 600px scroll
  Soufflo — Pack Duo 59,90 EUR
  ============================================================
{%- endcomment -%}

{%- comment -%}
  Le switcher Weglot est en position:fixed bottom:0 right:20px avec
  z-index:2147483647 (maximum absolu) : sur mobile il se superpose a la
  sticky bar et masque le bouton Commander. soufflo.fr etant en francais
  uniquement, le selecteur n'a aucune utilite ici.
{%- endcomment -%}
<style>
  @media (max-width: 767px) {
    #weglot-switcher-1,
    .weglot-container,
    aside.weglot_switcher { display: none !important; }
  }
</style>

<div class="sticky-bottom-bar" data-sticky-bar>
  <div class="sticky-bottom-bar__inner">
    <div class="sticky-bottom-bar__left">
      <img src="{{ 'soufflo-3A-hero-product.jpg' | asset_url }}" alt="Soufflo" width="44" height="44" class="sticky-bottom-bar__thumb" style="width:44px;height:44px;border-radius:0.5rem;object-fit:cover;flex-shrink:0;">
      <div class="sticky-bottom-bar__info">
        <span class="sticky-bottom-bar__name">Soufflo &middot; Pack Duo</span>
        <span class="sticky-bottom-bar__prices">
          <span class="sticky-bottom-bar__price">59,90 &euro;</span>
          <span class="sticky-bottom-bar__compare">69,80 &euro;</span>
        </span>
      </div>
    </div>
    <a href="/#product" class="sticky-bar-cta">Commander</a>
  </div>
</div>

<script>
(function() {
  var bar = document.querySelector('[data-sticky-bar]');
  if (!bar) return;

  function update() {
    if (window.scrollY > 400) {
      bar.classList.add('is-visible');
    } else {
      bar.classList.remove('is-visible');
    }
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>
