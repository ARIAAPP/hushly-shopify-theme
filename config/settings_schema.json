[
  {
    "name": "theme_info",
    "theme_name": "Hushly",
    "theme_version": "1.0.0",
    "theme_author": "Hushly",
    "theme_documentation_url": "https://hushlysleep.com",
    "theme_support_url": "https://hushlysleep.com"
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Marque"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Couleur primaire (violet profond)",
        "default": "#2D1B69"
      },
      {
        "type": "color",
        "id": "color_primary_foreground",
        "label": "Texte sur primaire",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur accent (lavande)",
        "default": "#B79CFF"
      },
      {
        "type": "color",
        "id": "color_accent_foreground",
        "label": "Texte sur accent",
        "default": "#1E1245"
      },
      {
        "type": "header",
        "content": "Fond et texte"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond",
        "default": "#FFFBF5"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Texte",
        "default": "#1E1245"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Fond secondaire",
        "default": "#F5F0FF"
      },
      {
        "type": "color",
        "id": "color_muted_foreground",
        "label": "Texte secondaire",
        "default": "#6B6380"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordure",
        "default": "#E8E0F0"
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Fond footer",
        "default": "#0B0F1E"
      },
      {
        "type": "color",
        "id": "color_footer_fg",
        "label": "Texte footer",
        "default": "#E8E0F0"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "select",
        "id": "font_family",
        "label": "Police",
        "default": "poppins",
        "options": [
          { "value": "poppins", "label": "Poppins" },
          { "value": "inter", "label": "Inter" },
          { "value": "system", "label": "Police systeme" }
        ]
      }
    ]
  },
  {
    "name": "Logo & Identite",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optionnel — si vide, texte stylise)"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "label": "Largeur max du logo",
        "min": 80,
        "max": 280,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "text",
        "id": "brand_text",
        "label": "Nom de la marque (si pas de logo)",
        "default": "hushly"
      },
      {
        "type": "text",
        "id": "brand_text_highlight",
        "label": "Mot a mettre en couleur primaire",
        "info": "Ex: 'ly' dans 'hushly'",
        "default": "ly"
      }
    ]
  },
  {
    "name": "Tracking & Analytics",
    "settings": [
      {
        "type": "header",
        "content": "Meta Pixel"
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "ID du Pixel Meta",
        "default": ""
      },
      {
        "type": "text",
        "id": "meta_domain_verification",
        "label": "Code de verification de domaine Meta",
        "default": ""
      },
      {
        "type": "header",
        "content": "Microsoft Clarity"
      },
      {
        "type": "text",
        "id": "clarity_id",
        "label": "ID Microsoft Clarity",
        "default": ""
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "label": "Largeur max du contenu",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Arrondi par defaut",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 12
      }
    ]
  }
]
