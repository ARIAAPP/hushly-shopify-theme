<section class="py-16 md:py-20">
  <div class="container">
    <div class="text-center space-y-2" style="margin-bottom: 2.5rem;">
      <h2 class="text-3xl font-bold">{{ section.settings.title }}</h2>
      <p class="text-muted-foreground">{{ section.settings.subtitle }}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {%- for block in section.blocks -%}
        <div class="rounded-2xl border bg-background text-center" {{ block.shopify_attributes }} style="border-color: var(--color-border); padding: 1.5rem 1rem;">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">{{ block.settings.icon }}</div>
          <h3 class="text-sm font-bold" style="margin-bottom: 0.25rem;">{{ block.settings.title }}</h3>
          <p class="text-xs text-muted-foreground">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="text-center" style="margin-top: 2rem;">
        <a href="{{ section.settings.cta_url }}" class="btn btn-lg">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pourquoi Hushly",
  "tag": "section",
  "class": "why-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Pourquoi des milliers de dormeurs choisissent Hushly"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Concu pour disparaitre. Pense pour t'endormir."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Je veux essayer Hushly"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "URL du bouton",
      "default": "/#product"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefice",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji",
          "default": "🌙"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Masque sommeil integre"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Le bandeau couvre aussi tes yeux."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pourquoi Hushly"
    }
  ]
}
{% endschema %}
