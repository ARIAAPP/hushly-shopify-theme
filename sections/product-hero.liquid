{%- comment -%}
  ProductSection — Hero (minimal test version)
  Soufflo — Ventilateur de plafond LED 30W E27
{%- endcomment -%}

<section id="product" class="py-8 md:py-14">
  <div class="container">
    <h1>{{ section.settings.headline | default: 'Ventilateur LED Soufflo' }}</h1>
    <p>{{ section.settings.subtitle | default: 'Fraicheur et lumiere, en un clic.' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Hero Produit",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Titre produit",
      "default": "Ventilateur LED Soufflo"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Fraicheur et lumiere, en un clic."
    }
  ],
  "presets": [
    {
      "name": "Hero Produit"
    }
  ]
}
{% endschema %}
