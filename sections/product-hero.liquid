<section id="product" class="py-8 md:py-14">
  <div class="container">
    <h1>{{ section.settings.headline | default: 'Ventilateur LED Soufflo' }}</h1>
    <p>{{ section.settings.subtitle | default: 'Fraicheur et lumiere.' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Hero Produit",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image principale"
    },
    {
      "type": "image_picker",
      "id": "gallery_images",
      "label": "Images galerie (jusqu'a 4)"
    },
    {
      "type": "header",
      "content": "Titre et sous-titre"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titre produit",
      "default": "Ventilateur LED Soufflo"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Fraicheur & lumiere — en un clic."
    },
    {
      "type": "header",
      "content": "Selection de pack"
    },
    {
      "type": "text",
      "id": "bundle_section_title",
      "label": "Titre du selecteur",
      "default": "Choisis ton pack"
    },
    {
      "type": "range",
      "id": "default_bundle_index",
      "label": "Bundle selectionne par defaut (1=premier, 2=deuxieme...)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Afficher le countdown",
      "default": true
    },
    {
      "type": "header",
      "content": "Bouton CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libelle du bouton",
      "default": "Commander maintenant"
    },
    {
      "type": "header",
      "content": "Mini-review featured"
    },
    {
      "type": "checkbox",
      "id": "show_featured_review",
      "label": "Afficher la mini-review",
      "default": true
    },
    {
      "type": "text",
      "id": "review_initials",
      "label": "Initiales",
      "default": "MT"
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Auteur",
      "default": "Marie T., Lyon"
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Texte de l'avis",
      "default": "Installation ultra simple, je l'ai visse en 10 secondes dans ma douille E27. Les 3 vitesses sont vraiment silencieuses et la telecommande est super pratique. Parfait pour l'ete !"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet benefice",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Se visse dans n'importe quelle douille E27 — 10 secondes"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nom du pack",
          "default": "Pack Essentiel"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description courte",
          "default": "1 ventilateur"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Shopify Variant ID",
          "default": ""
        },
        {
          "type": "number",
          "id": "quantity",
          "label": "Quantite",
          "default": 1
        },
        {
          "type": "number",
          "id": "price",
          "label": "Prix total (centimes)",
          "default": 3490,
          "info": "En centimes (3490 = 34,90€)"
        },
        {
          "type": "number",
          "id": "original_price",
          "label": "Prix barre (centimes)",
          "default": 3490
        },
        {
          "type": "number",
          "id": "save_amount",
          "label": "Economies (centimes)",
          "default": 0
        },
        {
          "type": "select",
          "id": "badge",
          "label": "Badge",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "popular", "label": "Populaire" },
            { "value": "best", "label": "Meilleure offre" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Texte du badge (override)"
        }
      ]
    },
    {
      "type": "upsell",
      "name": "Add-on / Upsell",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nom",
          "default": "Assurance colis (perte ou casse)"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description (optionnel)"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Shopify Variant ID",
          "default": ""
        },
        {
          "type": "number",
          "id": "price",
          "label": "Prix (centimes)",
          "default": 495,
          "info": "En centimes (495 = 4,95€)"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Section depliante",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Satisfait ou rembourse 30 jours"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenu",
          "default": "<p>Si le produit ne vous convient pas dans les 30 jours, nous vous remboursons integralement.</p>"
        }
      ]
    }
  ],
