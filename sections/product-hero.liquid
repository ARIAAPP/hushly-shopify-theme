{%- comment -%}
  ============================================================
  ProductSection — Hero / Bundles / Upsells / Countdown
  Soufflo — Ventilateur de plafond LED 30W E27 avec telecommande
  ============================================================
{%- endcomment -%}

<section id="product" class="py-8 md:py-14">
  <div class="container" style="display:grid; grid-template-columns:1fr; gap:2.5rem; align-items:start;">

    {%- comment -%} ===== DESKTOP 2-COL LAYOUT ===== {%- endcomment -%}
    <div class="product-hero-grid" style="display:grid; grid-template-columns:1fr; gap:2.5rem; align-items:start;">

    {%- comment -%} ========== LEFT: IMAGE GALLERY ========== {%- endcomment -%}
    <div class="space-y-4" style="position:relative;">

      {%- comment -%} Badge Nouveau {%- endcomment -%}
      <div style="position:absolute; top:1rem; left:1rem; z-index:10; background:var(--color-accent); color:var(--color-accent-fg); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; padding:0.3rem 0.75rem; border-radius:9999px; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
        Nouveau
      </div>

      {%- comment -%} Main image display — hardcoded from theme assets {%- endcomment -%}
      <div class="hero-gallery-container bg-secondary rounded-2xl overflow-hidden flex items-center justify-center relative" data-product-gallery-main>
        <img data-gallery-slide="0" src="{{ 'soufflo-3A-hero-product.jpg' | asset_url }}" alt="Ventilateur LED Soufflo — vue principale" class="w-full h-full object-cover" width="800" height="800" decoding="async">
        <img data-gallery-slide="1" src="{{ 'soufflo-3C-telecommande.jpg' | asset_url }}" alt="Ventilateur LED Soufflo — telecommande incluse" class="w-full h-full object-cover" width="800" height="800" loading="lazy" decoding="async" style="display:none;">
        <img data-gallery-slide="2" src="{{ 'soufflo-3D-chambre-nuit.jpg' | asset_url }}" alt="Ventilateur LED Soufflo — ambiance chambre" class="w-full h-full object-cover" width="800" height="800" loading="lazy" decoding="async" style="display:none;">
        <img data-gallery-slide="3" src="{{ 'soufflo-10D-vue-dessous.jpg' | asset_url }}" alt="Ventilateur LED Soufflo — vue de dessous pales" class="w-full h-full object-cover" width="800" height="800" loading="lazy" decoding="async" style="display:none;">
        <img data-gallery-slide="4" src="{{ 'soufflo-10E-produit-telecommande.jpg' | asset_url }}" alt="Ventilateur LED Soufflo — produit et telecommande" class="w-full h-full object-cover" width="800" height="800" loading="lazy" decoding="async" style="display:none;">
      </div>

      {%- comment -%} Thumbnails row — 5 slots {%- endcomment -%}
      <div class="flex gap-3 justify-center flex-wrap">
        <button type="button" class="gallery-thumb is-active" data-gallery-thumb="0" aria-label="Image principale" style="position:relative; height:5rem; width:5rem; border-radius:var(--radius); overflow:hidden; border:2px solid var(--color-primary); cursor:pointer; transition:border-color 0.15s; flex-shrink:0;">
          <img src="{{ 'soufflo-3A-hero-product.jpg' | asset_url }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
        </button>
        <button type="button" class="gallery-thumb" data-gallery-thumb="1" aria-label="Telecommande" style="position:relative; height:5rem; width:5rem; border-radius:var(--radius); overflow:hidden; border:2px solid transparent; cursor:pointer; transition:border-color 0.15s; flex-shrink:0;">
          <img src="{{ 'soufflo-3C-telecommande.jpg' | asset_url }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
        </button>
        <button type="button" class="gallery-thumb" data-gallery-thumb="2" aria-label="Ambiance chambre" style="position:relative; height:5rem; width:5rem; border-radius:var(--radius); overflow:hidden; border:2px solid transparent; cursor:pointer; transition:border-color 0.15s; flex-shrink:0;">
          <img src="{{ 'soufflo-3D-chambre-nuit.jpg' | asset_url }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
        </button>
        <button type="button" class="gallery-thumb" data-gallery-thumb="3" aria-label="Vue de dessous" style="position:relative; height:5rem; width:5rem; border-radius:var(--radius); overflow:hidden; border:2px solid transparent; cursor:pointer; transition:border-color 0.15s; flex-shrink:0;">
          <img src="{{ 'soufflo-10D-vue-dessous.jpg' | asset_url }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
        </button>
        <button type="button" class="gallery-thumb" data-gallery-thumb="4" aria-label="Produit et telecommande" style="position:relative; height:5rem; width:5rem; border-radius:var(--radius); overflow:hidden; border:2px solid transparent; cursor:pointer; transition:border-color 0.15s; flex-shrink:0;">
          <img src="{{ 'soufflo-10E-produit-telecommande.jpg' | asset_url }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
        </button>
      </div>
    </div>

    {%- comment -%} ========== RIGHT: PRODUCT INFO ========== {%- endcomment -%}
    <div class="space-y-5">

      {%- comment -%} 1. Avatar stack + rating {%- endcomment -%}
      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center -space-x-2">
          <img src="{{ 'soufflo-7A-avatar-marie.jpg' | asset_url }}" alt="" width="28" height="28" loading="lazy" style="width:28px; height:28px; border-radius:9999px; border:2px solid var(--color-bg); object-fit:cover;">
          <img src="{{ 'soufflo-7C-avatar-laurent.jpg' | asset_url }}" alt="" width="28" height="28" loading="lazy" style="width:28px; height:28px; border-radius:9999px; border:2px solid var(--color-bg); object-fit:cover;">
          <img src="{{ 'soufflo-8B-avatar-camille.jpg' | asset_url }}" alt="" width="28" height="28" loading="lazy" style="width:28px; height:28px; border-radius:9999px; border:2px solid var(--color-bg); object-fit:cover;">
          <img src="{{ 'soufflo-8A-avatar-thomas.jpg' | asset_url }}" alt="" width="28" height="28" loading="lazy" style="width:28px; height:28px; border-radius:9999px; border:2px solid var(--color-bg); object-fit:cover;">
          <img src="{{ 'soufflo-8C-avatar-marc.jpg' | asset_url }}" alt="" width="28" height="28" loading="lazy" style="width:28px; height:28px; border-radius:9999px; border:2px solid var(--color-bg); object-fit:cover;">
        </div>
        <a href="#reviews" class="flex items-center gap-1.5" style="text-decoration:none; color:inherit;">
          <span class="star-rating text-base" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="text-sm font-semibold" style="border-bottom:1px dashed currentColor;">4,8/5 &mdash; 150 avis</span>
        </a>
      </div>

      {%- comment -%} 2. Title {%- endcomment -%}
      <h1 class="text-2xl md:text-3xl font-bold leading-tight" style="word-wrap:break-word; overflow-wrap:break-word;">
        {{ section.settings.headline | default: 'Ventilateur LED Soufflo' }}
      </h1>

      {%- comment -%} 3. Subtitle {%- endcomment -%}
      <p class="text-base text-muted-foreground" style="margin-top:-0.5rem;">
        {{ section.settings.subtitle | default: 'Fraicheur & lumiere — en un clic.' }}
      </p>

      {%- comment -%} 4. Small tags {%- endcomment -%}
      <div class="flex flex-wrap gap-2" style="margin-top:0.25rem;">
        <span style="display:inline-flex; align-items:center; gap:0.3rem; background:color-mix(in srgb, var(--color-primary) 8%, transparent); color:var(--color-primary); font-size:0.75rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:9999px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          LED 30W dimmable
        </span>
        <span style="display:inline-flex; align-items:center; gap:0.3rem; background:color-mix(in srgb, var(--color-primary) 8%, transparent); color:var(--color-primary); font-size:0.75rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:9999px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
          3 vitesses silencieuses
        </span>
        <span style="display:inline-flex; align-items:center; gap:0.3rem; background:color-mix(in srgb, var(--color-primary) 8%, transparent); color:var(--color-primary); font-size:0.75rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:9999px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M12 7v10M7 12h10"/></svg>
          Telecommande incluse
        </span>
      </div>

      {%- comment -%} 5. Bullet points with checkmarks {%- endcomment -%}
      <div class="space-y-2" style="margin-top:0.5rem;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bullet' -%}
            <div class="flex items-start gap-2" {{ block.shopify_attributes }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
              <span class="text-sm" style="color:var(--color-fg);">{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} ===== 6. COUNTDOWN TIMER ===== {%- endcomment -%}
      {%- if section.settings.show_countdown -%}
        <div style="background:color-mix(in srgb, var(--color-accent) 12%, transparent); border:1px solid color-mix(in srgb, var(--color-accent) 25%, transparent); border-radius:var(--radius); padding:0.65rem 1rem; text-align:center;" data-countdown>
          <span style="font-size:0.85rem; font-weight:600; color:var(--color-accent);" data-countdown-text>
            Offre de lancement &mdash; se termine dans 00:00:00
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} ===== DIVIDER ===== {%- endcomment -%}
      <div class="flex items-center gap-4">
        <div class="h-px flex-1" style="background:var(--color-border);"></div>
        <span class="text-sm font-bold">{{ section.settings.bundle_section_title | default: 'Choisis ton pack' }}</span>
        <div class="h-px flex-1" style="background:var(--color-border);"></div>
      </div>

      {%- comment -%} ===== 7. BUNDLE PICKER ===== {%- endcomment -%}
      {%- liquid
        assign default_idx = section.settings.default_bundle_index | default: 2
        assign bundle_counter = 0
      -%}
      <div class="space-y-3" data-bundles>
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle' -%}
            {%- liquid
              assign bundle_counter = bundle_counter | plus: 1
              assign is_default = false
              if bundle_counter == default_idx
                assign is_default = true
              endif
            -%}
            <div>
              <button
                type="button"
                class="bundle-card"
                aria-pressed="{% if is_default %}true{% else %}false{% endif %}"
                data-bundle
                data-bundle-id="{{ block.id }}"
                data-bundle-variant="{{ block.settings.variant_id }}"
                data-bundle-quantity="{{ block.settings.quantity }}"
                data-bundle-price="{{ block.settings.price | divided_by: 100.0 }}"
                data-bundle-original="{{ block.settings.original_price | divided_by: 100.0 }}"
                data-bundle-label="{{ block.settings.label | escape }}"
                {{ block.shopify_attributes }}>

                {%- if block.settings.badge == 'popular' -%}
                  <span class="bundle-badge bundle-badge--popular">{{ block.settings.badge_text | default: 'Populaire' }}</span>
                {%- elsif block.settings.badge == 'best' -%}
                  <span class="bundle-badge bundle-badge--best">{{ block.settings.badge_text | default: 'Meilleure offre' }}</span>
                {%- endif -%}

                <div class="bundle-row">
                  <div class="bundle-info">
                    <div class="bundle-radio"></div>
                    <div class="bundle-label-group">
                      <div class="bundle-label-line">
                        <span class="font-semibold">{{ block.settings.label }}</span>
                        {%- if block.settings.save_amount > 0 -%}
                          <span class="bundle-save text-xs font-semibold text-primary">
                            ECONOMISEZ {{ block.settings.save_amount | divided_by: 100.0 }}€
                          </span>
                        {%- endif -%}
                      </div>
                      <p class="text-xs text-muted-foreground">{{ block.settings.description }}</p>
                    </div>
                  </div>
                  <div class="bundle-price">
                    <span class="font-bold text-lg">{{ block.settings.price | divided_by: 100.0 }}€</span>
                    {%- if block.settings.original_price > block.settings.price -%}
                      <p class="text-xs line-through text-muted-foreground">{{ block.settings.original_price | divided_by: 100.0 }}€</p>
                    {%- endif -%}
                  </div>
                </div>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} ===== 8. UPSELLS (checkboxes) ===== {%- endcomment -%}
      {%- assign has_upsells = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'upsell' -%}
          {%- assign has_upsells = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_upsells -%}
        <div style="border:1px solid var(--color-border); border-radius:var(--radius); padding:0.75rem 1rem;" data-upsells-container>
          <p class="text-xs font-semibold text-muted-foreground" style="margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:0.05em;">Ajoutez a votre commande</p>
          {%- for block in section.blocks -%}
            {%- if block.type == 'upsell' -%}
              <label class="flex items-center justify-between cursor-pointer" style="padding:0.4rem 0;{%- unless forloop.last -%}border-bottom:1px solid var(--color-border);{%- endunless -%}" {{ block.shopify_attributes }}>
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <input
                    type="checkbox"
                    data-upsell
                    data-upsell-id="{{ block.id }}"
                    data-upsell-variant="{{ block.settings.variant_id }}"
                    data-upsell-price="{{ block.settings.price | divided_by: 100.0 }}"
                    data-upsell-label="{{ block.settings.label | escape }}"
                    style="width:1rem; height:1rem; accent-color:var(--color-primary); cursor:pointer;">
                  <span class="text-sm">{{ block.settings.label }}</span>
                  {%- if block.settings.description != blank -%}
                    <span class="text-xs text-muted-foreground hidden" style="display:none;">{{ block.settings.description }}</span>
                  {%- endif -%}
                </div>
                <span class="text-sm font-semibold whitespace-nowrap" style="margin-left:0.5rem;">+{{ block.settings.price | divided_by: 100.0 }}€</span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== 9. CTA BUTTON ===== {%- endcomment -%}
      <button type="button" class="btn btn-block btn-lg" data-add-to-cart style="position:relative; overflow:hidden;">
        <span data-cta-text>{{ section.settings.cta_label | default: 'Commander maintenant' }} &mdash; <span data-cta-price>59,90€</span></span>
      </button>

      {%- comment -%} ===== 10. TRUST STRIP ===== {%- endcomment -%}
      <div class="trust-badges">
        <div class="trust-badge">
          <span class="trust-icon">&#128737;&#65039;</span>
          <span class="trust-label">Satisfait<br>30 jours</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">&#128666;</span>
          <span class="trust-label">Livraison<br>offerte</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon">&#128274;</span>
          <span class="trust-label">Paiement<br>securise</span>
        </div>
        <div class="trust-badge">
          <span class="trust-icon" style="color:#facc15;">&#9733;</span>
          <span class="trust-label">4,8/5<br>150 avis</span>
        </div>
      </div>

      {%- comment -%} ===== 11. PAYMENT ICONS ===== {%- endcomment -%}
      <div class="pt-1">{% render 'payment-icons' %}</div>

      {%- comment -%} ===== 12. FEATURED REVIEW ===== {%- endcomment -%}
      {%- if section.settings.show_featured_review -%}
        <div class="flex items-start gap-3 rounded-xl border p-4" style="border-color:var(--color-border);">
          <img src="{{ 'soufflo-7A-avatar-marie.jpg' | asset_url }}" alt="{{ section.settings.review_author | default: 'Marie T.' }}" class="h-10 w-10 shrink-0 rounded-full object-cover" width="40" height="40" loading="lazy">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-semibold">{{ section.settings.review_author | default: 'Marie T., Lyon' }}</span>
              <span class="text-xs star-rating" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <span style="display:inline-flex; align-items:center; gap:0.2rem; font-size:10px; color:var(--color-primary); font-weight:600;">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="var(--color-primary)" stroke="none"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Achat verifie
              </span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">{{ section.settings.review_text | default: "Installation ultra simple, je l'ai visse en 10 secondes dans ma douille E27. Les 3 vitesses sont vraiment silencieuses et la telecommande est super pratique. Parfait pour l'ete !" }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ===== 13. COLLAPSIBLES ===== {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collapsible' -%}
          <details class="faq-item" {{ block.shopify_attributes }} style="border-top:1px solid var(--color-border); border-bottom:0;">
            <summary class="flex items-center justify-between" style="padding:0.75rem 0;">
              <span class="flex items-center gap-2">
                <span>{{ block.settings.emoji }}</span>
                <span class="text-sm font-bold">{{ block.settings.title }}</span>
              </span>
            </summary>
            <div class="text-sm text-muted-foreground" style="padding:0 0 0.75rem;">
              {{ block.settings.content }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ===== 14. SOCIAL COUNTER ===== {%- endcomment -%}
      <div style="text-align:center; padding:0.6rem 0;">
        <span class="flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span data-social-counter>327 clients satisfaits ce mois-ci</span>
        </span>
      </div>

    </div>{%- comment -%} /right col {%- endcomment -%}
    </div>{%- comment -%} /product-hero-grid {%- endcomment -%}
  </div>
</section>

{%- comment -%} ===== RESPONSIVE GRID ===== {%- endcomment -%}
<style>
  @media (min-width: 1024px) {
    .product-hero-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

{%- comment -%} ===== JAVASCRIPT ===== {%- endcomment -%}

{% schema %}
{
  "name": "Hero Produit",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image principale"
    },
    {
      "type": "image_picker",
      "id": "gallery_images",
      "label": "Images galerie (jusqu'a 4)"
    },
    {
      "type": "header",
      "content": "Titre et sous-titre"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titre produit",
      "default": "Ventilateur LED Soufflo"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Fraicheur & lumiere — en un clic."
    },
    {
      "type": "header",
      "content": "Selection de pack"
    },
    {
      "type": "text",
      "id": "bundle_section_title",
      "label": "Titre du selecteur",
      "default": "Choisis ton pack"
    },
    {
      "type": "range",
      "id": "default_bundle_index",
      "label": "Bundle selectionne par defaut (1=premier, 2=deuxieme...)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Afficher le countdown",
      "default": true
    },
    {
      "type": "header",
      "content": "Bouton CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libelle du bouton",
      "default": "Commander maintenant"
    },
    {
      "type": "header",
      "content": "Mini-review featured"
    },
    {
      "type": "checkbox",
      "id": "show_featured_review",
      "label": "Afficher la mini-review",
      "default": true
    },
    {
      "type": "text",
      "id": "review_initials",
      "label": "Initiales",
      "default": "MT"
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Auteur",
      "default": "Marie T., Lyon"
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Texte de l'avis",
      "default": "Installation ultra simple, je l'ai visse en 10 secondes dans ma douille E27. Les 3 vitesses sont vraiment silencieuses et la telecommande est super pratique. Parfait pour l'ete !"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet benefice",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Se visse dans n'importe quelle douille E27 — 10 secondes"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nom du pack",
          "default": "Pack Essentiel"
        },
        {
          "type": "text",
