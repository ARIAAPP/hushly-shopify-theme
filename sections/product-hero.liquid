{%- comment -%} ===== RESPONSIVE GRID ===== {%- endcomment -%}
<style>
  @media (min-width: 1024px) {
    .product-hero-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }

  {%- comment -%}
    ===== MOBILE : titre + prix au-dessus de la ligne de flottaison =====
    95 % du trafic est mobile. Avant : H1 a 1004px, prix a 1175px (viewport 812px)
    -> il fallait scroller 1,4 ecran pour voir un prix.
    Les 10 vignettes de 5rem s'empilaient sur 4 rangees (~356px) avant le titre.
  {%- endcomment -%}
  @media (max-width: 767px) {
    /* 0. Les enfants de grid ont min-width:auto par defaut : ils s'etirent au
       contenu et debordent horizontalement. Indispensable pour que la rangee
       de vignettes scrollable reste contenue dans le viewport. */
    #product .product-hero-grid,
    #product .product-hero-grid > div { min-width: 0 !important; }

    /* 1. Haut de section resserre */
    #product { padding-top: 0.75rem !important; }

    /* 3. Vignettes : une seule rangee scrollable au lieu de 4 rangees empilees */
    [data-gallery-thumbs] {
      flex-wrap: nowrap !important;
      justify-content: flex-start !important;
      max-width: 100%;
      overflow-x: auto;
      margin-top: 0.75rem !important;
      padding-bottom: 0.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    [data-gallery-thumbs]::-webkit-scrollbar { display: none; }
    [data-gallery-thumbs] .gallery-thumb {
      height: 3.25rem !important;
      width: 3.25rem !important;
    }

    /* 4. Bloc infos : espacements resserres */
    #product .space-y-5 > * + * { margin-top: 0.75rem !important; }
  }

  details summary::-webkit-details-marker { display: none; }
  details[open] summary svg { transform: rotate(180deg); }
</style>

{%- comment -%} ===== JAVASCRIPT ===== {%- endcomment -%}
<script>
(function() {
  var section = document.currentScript.closest('section') || document.getElementById('product');
  if (!section) return;

  /* ---- GALLERY ---- */
  var slides = section.querySelectorAll('[data-gallery-slide]');
  var thumbs = section.querySelectorAll('[data-gallery-thumb]');
  function showSlide(idx) {
    slides.forEach(function(s) {
      var active = s.getAttribute('data-gallery-slide') === String(idx);
      s.style.display = active ? '' : 'none';
      /* Pause/play video slides */
      if (s.tagName === 'VIDEO') {
        if (active) { s.play(); } else { s.pause(); }
      }
    });
    thumbs.forEach(function(t) { var a = t.getAttribute('data-gallery-thumb') === String(idx); t.style.borderColor = a ? 'var(--color-primary)' : 'transparent'; });
  }
  thumbs.forEach(function(t) { t.addEventListener('click', function() { showSlide(parseInt(t.getAttribute('data-gallery-thumb'), 10)); }); });
  if (slides.length) slides[0].style.display = '';

  /* ---- BUNDLES + UPSELLS INSIDE ---- */
  var bundleCards = section.querySelectorAll('[data-bundle]');
  var ctaPrice = section.querySelector('[data-cta-price]');
  var heroTotal = section.querySelector('[data-hero-total]');

  /* Build upsells HTML once (reused when moving between bundles) */
  var upsellsHTML = '';
  var upsellsContainer = section.querySelector('[data-upsells-inside]');
  if (upsellsContainer) {
    upsellsHTML = upsellsContainer.innerHTML;
  }

  var __cc = {{ _cc | json }};
  var __cs = {{ _cs | json }};
  function formatPrice(val) {
    if (__cc === 'EUR') return val.toFixed(2).replace('.', ',') + ' €';
    return __cs + val.toFixed(2);
  }

  function getSelectedBundlePrice() {
    var sel = section.querySelector('[data-bundle][aria-pressed="true"]');
    return sel ? parseFloat(sel.getAttribute('data-bundle-price')) : 0;
  }

  function getUpsellsTotal() {
    var t = 0;
    section.querySelectorAll('[data-upsell]:checked').forEach(function(u) { t += parseFloat(u.getAttribute('data-upsell-price') || '0'); });
    return t;
  }

  function updateCTA() {
    var total = getSelectedBundlePrice() + getUpsellsTotal();
    if (ctaPrice) ctaPrice.textContent = formatPrice(total);
    if (heroTotal) heroTotal.textContent = formatPrice(total);
  }

  function selectBundle(card) {
    /* Remove upsells from previously selected */
    bundleCards.forEach(function(b) {
      b.setAttribute('aria-pressed', 'false');
      b.style.borderColor = 'var(--color-border)';
      b.style.background = '';
      /* Remove upsells inside */
      var existing = b.querySelector('[data-upsells-inside]');
      if (existing) existing.remove();
      /* Reset radio */
      var radio = b.querySelector('.bundle-radio-circle');
      if (radio) { radio.style.borderColor = 'var(--color-muted-fg)'; radio.innerHTML = ''; }
    });

    /* Select this card */
    card.setAttribute('aria-pressed', 'true');
    card.style.borderColor = 'var(--color-primary)';
    card.style.background = 'color-mix(in srgb, var(--color-primary) 5%, transparent)';

    /* Fill radio */
    var radio = card.querySelector('.bundle-radio-circle');
    if (radio) {
      radio.style.borderColor = 'var(--color-primary)';
      radio.innerHTML = '<div style="height:0.625rem;width:0.625rem;border-radius:9999px;background:var(--color-primary);"></div>';
    }

    /* Add upsells inside */
    var div = document.createElement('div');
    div.className = 'upsells-inside';
    div.setAttribute('data-upsells-inside', '');
    div.style.cssText = 'margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border);';
    div.innerHTML = upsellsHTML;
    card.appendChild(div);

    /* Rebind upsell checkboxes */
    div.querySelectorAll('[data-upsell]').forEach(function(u) {
      u.addEventListener('change', function() { updateCTA(); });
    });

    updateCTA();
  }

  bundleCards.forEach(function(b) {
    b.addEventListener('click', function(e) {
      if (e.target.closest('[data-upsell]') || e.target.closest('label')) return;
      selectBundle(b);
    });
    b.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectBundle(b); }
    });
  });

  /* Initial upsell bindings */
  section.querySelectorAll('[data-upsell]').forEach(function(u) {
    u.addEventListener('change', function() { updateCTA(); });
  });

  updateCTA();

  /* ---- COUNTDOWN ---- */
  var cdEl = section.querySelector('[data-countdown-timer]');
  if (cdEl) {
    var KEY = 'soufflo-hero-countdown-end', endTime = 0;
    try { var s = localStorage.getItem(KEY); if (s) endTime = parseInt(s, 10); } catch(e){}
    if (!endTime || endTime <= Date.now()) {
      endTime = Date.now() + (20 + Math.random()*4)*3600000;
      try { localStorage.setItem(KEY, String(endTime)); } catch(e){}
    }
    var pad = function(n) { return String(n).padStart(2,'0'); };
    function tick() {
      var r = Math.max(0, endTime - Date.now());
      if (r <= 0) { endTime = Date.now()+(20+Math.random()*4)*3600000; try{localStorage.setItem(KEY,String(endTime));}catch(e){} r = endTime-Date.now(); }
      // Seul le timer est mis a jour : le libelle reste un noeud statique traduisible par Weglot.
      cdEl.textContent = pad(Math.floor(r/3600000))+':'+pad(Math.floor(r%3600000/60000))+':'+pad(Math.floor(r%60000/1000));
    }
    tick(); setInterval(tick, 1000);
  }

  /* ---- ADD TO CART ---- */
  var atcBtn = section.querySelector('[data-add-to-cart]');
  if (atcBtn) {
    atcBtn.addEventListener('click', function() {
      var sel = section.querySelector('[data-bundle][aria-pressed="true"]') || bundleCards[0];
      if (!sel) return;
      // FIX panier : la variante du pack EST deja le prix complet (Duo=59,90 / Maison=79,90) -> TOUJOURS quantite 1.
      // data-bundle-quantity (1/2/3) = nb de ventilateurs (affichage + mapping DSers BOGO), PAS la quantite panier.
      var vid = sel.getAttribute('data-bundle-variant');
      var bp = parseFloat(sel.getAttribute('data-bundle-price'));
      var items = [{ id:'main-product', variantId:vid, title:sel.getAttribute('data-bundle-label')||'Ventilateur LED Soufflo', price:bp, quantity:1, image:sel.getAttribute('data-bundle-image')||'' }];
      section.querySelectorAll('[data-upsell]:checked').forEach(function(u) {
        items.push({ id:u.getAttribute('data-upsell-id'), variantId:u.getAttribute('data-upsell-variant'), title:u.getAttribute('data-upsell-label'), price:parseFloat(u.getAttribute('data-upsell-price')), quantity:1 });
      });
      if (window.SouffloCart) window.SouffloCart.openWith(items);
      if (window.fbq) {
        var cv = items.reduce(function(s,i){return s+i.price*i.quantity;},0);
        window.fbq('track','AddToCart',{value:+cv.toFixed(2),currency:__cc,content_ids:items.map(function(i){return i.variantId;}),content_type:'product',num_items:items.reduce(function(s,i){return s+i.quantity;},0)});
      }
    });
  }

  /* ---- ViewContent pixel ---- */
  if (window.fbq) {
    setTimeout(function() {
      window.fbq('track','ViewContent',{content_ids:['ventilateur-led-soufflo'],content_type:'product',value:getSelectedBundlePrice(),currency:__cc});
    }, 800);
  }
})();
</script>

