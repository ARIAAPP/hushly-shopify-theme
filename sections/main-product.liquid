{%- comment -%}
  Main Product section — single-product store redirect to homepage
{%- endcomment -%}

<script>
  if (window.location.pathname !== '/') {
    window.location.replace('/#product');
  }
</script>

<section class="section" style="text-align:center;">
  <div class="container">
    <p>Redirection...</p>
    <a class="btn btn-primary" href="{{ routes.root_url }}#product" style="margin-top:1rem;">Voir le produit</a>
  </div>
</section>

{% schema %}
{
  "name": "Produit principal",
  "tag": "section",
  "class": "main-product-section",
  "settings": []
}
{% endschema %}
