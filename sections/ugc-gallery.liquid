{%- comment -%}
  ============================================================
  UGC Gallery — Customer photos grid
  Soufflo — Ventilateur LED E27
  ============================================================
{%- endcomment -%}

<section id="ugc-gallery" class="section-padding" style="background:#fff;">
  <div class="container">

    {%- comment -%} Header {%- endcomment -%}
    <div style="max-width:36rem; margin-left:auto; margin-right:auto; text-align:center; margin-bottom:2.5rem;">
      <h2 style="color:#0C4A6E;" class="text-3xl font-bold mb-2">Chez nos clients</h2>
      <p class="text-muted-foreground">Ils ont &eacute;quip&eacute; leur int&eacute;rieur avec Soufflo.</p>
    </div>

    {%- comment -%} Carrousel videos UGC (autoplay au scroll, snap) {%- endcomment -%}
    {%- assign svid_list = 'soufflo-video-1|soufflo-video-2|soufflo-video-3|soufflo-video-4|soufflo-video-5' | split: '|' -%}
    <div class="svid-carousel" data-svid-carousel>
      <button type="button" class="svid-arrow svid-arrow--prev" aria-label="Vid&eacute;o pr&eacute;c&eacute;dente" data-svid-prev>&#8249;</button>
      <div class="svid-scroller" data-svid-scroller>
        {%- for vid in svid_list -%}
        <div class="svid-item">
          <video
            data-svid-video
            src="{{ vid | append: '.mp4' | asset_url }}"
            poster="{{ vid | append: '-poster.jpg' | asset_url }}"
            muted loop playsinline preload="none"
            width="270" height="480"></video>
          <button type="button" class="svid-sound" data-svid-sound aria-label="Activer le son">
            <span class="svid-sound__off">&#128263;</span>
            <span class="svid-sound__on" hidden>&#128266;</span>
          </button>
        </div>
        {%- endfor -%}
      </div>
      <button type="button" class="svid-arrow svid-arrow--next" aria-label="Vid&eacute;o suivante" data-svid-next>&#8250;</button>
    </div>

    {%- comment -%} Avis client avec photos {%- endcomment -%}
    <div class="ugc-review-card">
      <div class="ugc-review-card__header">
        <div class="ugc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <span class="ugc-review-card__author">Sandrine M. &middot; <span style="color:var(--color-muted-fg);font-weight:400;">Client v&eacute;rifi&eacute;</span></span>
        <p class="ugc-review-card__text">&laquo; Super contente, 2&egrave;me commande pour ma fille ! S'installe facilement, bonne lumi&egrave;re et le ventilo est vraiment silencieux. Je recommande &raquo;</p>
      </div>
      <div class="ugc-review-card__photos">
        <img src="{{ 'soufflo-ugc-review-1.jpg' | asset_url }}" alt="Photo client Soufflo" width="300" height="300" loading="lazy">
        <img src="{{ 'soufflo-ugc-review-2.jpg' | asset_url }}" alt="Photo client Soufflo" width="300" height="300" loading="lazy">
        <img src="{{ 'soufflo-ugc-review-3.jpg' | asset_url }}" alt="Photo client Soufflo installé" width="300" height="300" loading="lazy">
        <img src="{{ 'soufflo-ugc-review-4.jpg' | asset_url }}" alt="Photo client Soufflo installé" width="300" height="300" loading="lazy">
      </div>
    </div>

    {%- comment -%} Grid — uses existing CSS .ugc-gallery__grid {%- endcomment -%}
    <div class="ugc-gallery__grid">

      <div class="ugc-item">
        <img src="{{ 'soufflo-11A-ugc-femme-ravie.jpg' | asset_url }}" alt="Cliente ravie avec Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@sophie.deco &middot; &laquo; Mon salon a chang&eacute; &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11B-ugc-homme-installation.jpg' | asset_url }}" alt="Installation du Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@thomas.r &middot; &laquo; Install&eacute; en 10 secondes &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11C-ugc-couple-canape.jpg' | asset_url }}" alt="Couple profitant du Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@nathalie.d &middot; &laquo; Tout depuis le canap&eacute; &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11E-ugc-temoignage-v1.jpg' | asset_url }}" alt="Témoignage client Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@maman.lulu &middot; &laquo; B&eacute;b&eacute; dort enfin &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11D-ugc-comparaison-split.jpg' | asset_url }}" alt="Comparaison avant/après Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@cocooning.fr &middot; &laquo; Le jour et la nuit &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11F-ugc-unboxing.jpg' | asset_url }}" alt="Unboxing Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@maison.moderne &middot; &laquo; Re&ccedil;u et install&eacute; en 2 min &raquo;</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .ugc-review-card {
    max-width: 48rem;
    margin: 0 auto 3rem;
    background: #f8fafc;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(12,74,110,0.08);
  }
  .ugc-review-card__stars {
    color: #f59e0b;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }
  .ugc-review-card__author {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: 0.35rem;
    color: #0C4A6E;
  }
  .ugc-review-card__text {
    font-size: 0.9rem;
    color: #334155;
    margin-top: 0.5rem;
    line-height: 1.5;
    font-style: italic;
  }
  .ugc-review-card__photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .ugc-review-card__photos img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.5rem;
  }
  @media (max-width: 600px) {
    .ugc-review-card__photos {
      grid-template-columns: repeat(2, 1fr);
    }
    .ugc-review-card { padding: 1rem; }
  }

  .svid-carousel {
    position: relative;
    margin: 0 auto 3rem;
    max-width: 62rem;
  }
  .svid-scroller {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.25rem;
  }
  .svid-scroller::-webkit-scrollbar { display: none; }
  .svid-scroller:has(> :only-child) { justify-content: center; }
  .svid-item {
    flex: 0 0 auto;
    scroll-snap-align: center;
    position: relative;
  }
  .svid-sound {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: none;
    background: rgba(12, 74, 110, 0.75);
    color: #fff;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .svid-item video {
    display: block;
    width: 240px;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 1rem;
    background: #0C4A6E;
    box-shadow: 0 8px 24px rgba(12, 74, 110, 0.15);
  }
  .svid-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: none;
    background: #0C4A6E;
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(12, 74, 110, 0.3);
  }
  .svid-arrow--prev { left: -1rem; }
  .svid-arrow--next { right: -1rem; }
  @media (min-width: 768px) {
    .svid-arrow { display: flex; }
    .svid-item video { width: 270px; }
  }
</style>

<script>
(function() {
  var carousel = document.querySelector('[data-svid-carousel]');
  if (!carousel) return;

  var scroller = carousel.querySelector('[data-svid-scroller]');
  var videos = carousel.querySelectorAll('[data-svid-video]');

  /* Son : un seul deverrouille a la fois */
  function setSound(video, on) {
    video.muted = !on;
    var btn = video.parentElement.querySelector('[data-svid-sound]');
    if (!btn) return;
    btn.querySelector('.svid-sound__off').hidden = on;
    btn.querySelector('.svid-sound__on').hidden = !on;
    btn.setAttribute('aria-label', on ? 'Couper le son' : 'Activer le son');
  }

  carousel.querySelectorAll('[data-svid-sound]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var video = btn.parentElement.querySelector('[data-svid-video]');
      var turnOn = video.muted;
      videos.forEach(function(v) { setSound(v, false); });
      if (turnOn) {
        setSound(video, true);
        video.play().catch(function() {});
      }
    });
  });

  /* Autoplay/pause au scroll */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var v = entry.target;
        if (entry.intersectionRatio >= 0.4) {
          v.play().catch(function() {});
        } else {
          v.pause();
          if (!v.muted) setSound(v, false);
        }
      });
    }, { threshold: [0, 0.4] });
    videos.forEach(function(v) { io.observe(v); });
  }

  /* Fleches desktop */
  var step = 286;
  var prev = carousel.querySelector('[data-svid-prev]');
  var next = carousel.querySelector('[data-svid-next]');
  if (prev) prev.addEventListener('click', function() { scroller.scrollBy({ left: -step, behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function() { scroller.scrollBy({ left: step, behavior: 'smooth' }); });
})();
</script>

{% schema %}
{
  "name": "Galerie UGC",
  "settings": [],
  "presets": [{ "name": "Galerie UGC" }]
}
{% endschema %}
