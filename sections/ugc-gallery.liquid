{%- comment -%}
  ============================================================
  UGC Gallery — Customer photos grid
  Soufflo — Ventilateur LED E27
  ============================================================
{%- endcomment -%}

<section id="ugc-gallery" class="section-padding" style="background:#fff;">
  <div class="container">

    {%- comment -%} Header {%- endcomment -%}
    <div style="max-width:36rem; margin-left:auto; margin-right:auto; text-align:center; margin-bottom:2.5rem;">
      <h2 style="color:#0C4A6E;" class="text-3xl font-bold mb-2">Chez nos clients</h2>
      <p class="text-muted-foreground">Ils ont &eacute;quip&eacute; leur int&eacute;rieur avec Soufflo.</p>
    </div>

    {%- comment -%} Grid — uses existing CSS .ugc-gallery__grid {%- endcomment -%}
    <div class="ugc-gallery__grid">

      <div class="ugc-item">
        <img src="{{ 'soufflo-11A-ugc-femme-ravie.jpg' | asset_url }}" alt="Cliente ravie avec Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@sophie.deco &middot; &laquo; Mon salon a chang&eacute; &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11B-ugc-homme-installation.jpg' | asset_url }}" alt="Installation du Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@thomas.r &middot; &laquo; Install&eacute; en 10 secondes &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11C-ugc-couple-canape.jpg' | asset_url }}" alt="Couple profitant du Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@nathalie.d &middot; &laquo; Tout depuis le canap&eacute; &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11E-ugc-temoignage-v1.jpg' | asset_url }}" alt="Témoignage client Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@maman.lulu &middot; &laquo; B&eacute;b&eacute; dort enfin &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11D-ugc-comparaison-split.jpg' | asset_url }}" alt="Comparaison avant/après Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@cocooning.fr &middot; &laquo; Le jour et la nuit &raquo;</span>
        </div>
      </div>

      <div class="ugc-item">
        <img src="{{ 'soufflo-11F-ugc-unboxing.jpg' | asset_url }}" alt="Unboxing Soufflo" width="400" height="400" loading="lazy">
        <div class="ugc-item__overlay">
          <span class="ugc-item__caption">@maison.moderne &middot; &laquo; Re&ccedil;u et install&eacute; en 2 min &raquo;</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galerie UGC",
  "settings": [],
  "presets": [{ "name": "Galerie UGC" }]
}
{% endschema %}
