{%- comment -%}
  ============================================================
  UGC Gallery — Masonry-style customer photos
  Soufflo — Ventilateur LED E27
  ============================================================
{%- endcomment -%}

<section id="ugc-gallery" class="section-padding" style="background:#fff;">
  <div class="container">

    {%- comment -%} Header {%- endcomment -%}
    <div style="max-width:36rem; margin-left:auto; margin-right:auto; text-align:center; margin-bottom:2.5rem;">
      <h2 style="color:#0C4A6E;" class="text-3xl font-bold mb-2">Chez nos clients</h2>
      <p class="text-muted-foreground">Ils ont &eacute;quip&eacute; leur int&eacute;rieur avec Soufflo.</p>
    </div>

    {%- comment -%} Masonry grid {%- endcomment -%}
    <div class="ugc-masonry" style="column-count:2; column-gap:1rem;">

      {%- comment -%} 1 — Sophie (square) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:1/1;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@sophie.deco &middot; &laquo; Mon salon a chang&eacute; &raquo;</p>
        </div>
      </div>

      {%- comment -%} 2 — Maman Lulu (tall 3/4) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:3/4;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@maman.lulu &middot; &laquo; B&eacute;b&eacute; dort enfin &raquo;</p>
        </div>
      </div>

      {%- comment -%} 3 — Thomas (square) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:1/1;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@thomas.r &middot; &laquo; 10 sec chrono &raquo;</p>
        </div>
      </div>

      {%- comment -%} 4 — Cocooning (tall 3/4) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:3/4;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@cocooning.fr &middot; &laquo; Lumi&egrave;re douce parfaite &raquo;</p>
        </div>
      </div>

      {%- comment -%} 5 — Nathalie (square) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:1/1;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@nathalie.d &middot; &laquo; Tout depuis le canap&eacute; &raquo;</p>
        </div>
      </div>

      {%- comment -%} 6 — Maison Moderne (square) {%- endcomment -%}
      <div style="border-radius:1rem; overflow:hidden; margin-bottom:1rem; position:relative; break-inside:avoid;" class="bg-surface">
        <div class="lavender-gradient" style="width:100%; aspect-ratio:1/1;"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; padding:0.75rem 1rem; background:linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <p style="color:#fff; font-size:0.8125rem; font-style:italic; margin:0;">@maison.moderne &middot; &laquo; Discret au plafond &raquo;</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .ugc-masonry { column-count: 3 !important; }
  }
  @media (min-width: 1024px) {
    .ugc-masonry { column-count: 4 !important; }
  }
</style>

{% schema %}
{
  "name": "Galerie UGC",
  "settings": [],
  "presets": [{ "name": "Galerie UGC" }]
}
{% endschema %}
