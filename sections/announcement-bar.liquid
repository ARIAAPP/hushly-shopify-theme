<div class="announcement-bar" aria-label="Informations boutique">
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <span class="announcement-bar__item">{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span class="announcement-bar__item">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Barre d'annonce",
  "class": "announcement-bar-section",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Message" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [
        { "type": "message", "settings": { "text": "🚚 Livraison offerte en France" } },
        { "type": "message", "settings": { "text": "✅ Satisfait ou remboursé 30 jours" } },
        { "type": "message", "settings": { "text": "⚡ Installation en 10 secondes" } },
        { "type": "message", "settings": { "text": "🎮 Télécommande incluse" } },
        { "type": "message", "settings": { "text": "📦 Expédition rapide + suivi" } }
      ]
    }
  ]
}
{% endschema %}
