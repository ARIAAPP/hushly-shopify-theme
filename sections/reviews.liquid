{%- comment -%}
  ============================================================
  Reviews Section — Customer reviews with stars, avatars, photos
  Soufflo — Ventilateur LED E27
  ============================================================
{%- endcomment -%}

<section id="reviews" class="section-padding bg-surface">
  <div class="container">

    {%- comment -%} Heading {%- endcomment -%}
    <div class="text-center mb-2">
      <h2 style="color:#0C4A6E;" class="text-3xl font-bold">4,8/5 &mdash; 150 avis v&eacute;rifi&eacute;s <span style="color:#38BDF8;">&#9733;&#9733;&#9733;&#9733;&#9733;</span></h2>
    </div>

    {%- comment -%} Filter text {%- endcomment -%}
    <p class="text-center text-sm text-muted-foreground mb-0">Tous (150) &middot; 5&#9733; (128) &middot; 4&#9733; (18) &middot; Avec photo (42)</p>

    {%- comment -%} Reviews grid {%- endcomment -%}
    <div class="reviews__grid" style="margin-top:2.5rem; max-width:64rem; margin-left:auto; margin-right:auto;">

      {%- comment -%} Review 1 — Marie T. — 5★ — 1 photo {%- endcomment -%}
      <div class="review-card soft-shadow">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <img src="{{ 'soufflo-7A-avatar-marie.jpg' | asset_url }}" alt="Marie T." width="40" height="40" loading="lazy" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold">Marie T.</span>
                <span class="text-xs text-muted-foreground">&middot; Lyon</span>
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-medium" style="background:#F0FDF4; color:#16A34A; padding:0.125rem 0.5rem; border-radius:9999px;">&#10003; Achat v&eacute;rifi&eacute;</span>
            </div>
          </div>
          <div class="text-right">
            <div style="color:#38BDF8; font-size:0.875rem;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs text-muted-foreground mb-0" style="opacity:0.6;">il y a 2 jours</p>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground mb-3">Incroyable, je l'ai viss&eacute; en 10 secondes et &ccedil;a change la vie en &eacute;t&eacute;&nbsp;! La lumi&egrave;re est douce et le ventilo super silencieux.</p>
        <div class="flex gap-2">
          <img src="{{ 'soufflo-4A-salon-moderne.jpg' | asset_url }}" alt="Photo avis client" width="64" height="64" loading="lazy" style="width:64px; height:64px; border-radius:0.5rem; flex-shrink:0; object-fit:cover;">
        </div>
      </div>

      {%- comment -%} Review 2 — Jean-Pierre L. — 5★ — 0 photos {%- endcomment -%}
      <div class="review-card soft-shadow">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <div style="width:40px; height:40px; border-radius:50%; background:#38BDF8; color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.875rem; font-weight:700; flex-shrink:0;">JL</div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold">Jean-Pierre L.</span>
                <span class="text-xs text-muted-foreground">&middot; Marseille</span>
