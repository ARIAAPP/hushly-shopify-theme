      {%- comment -%} Review 6 — Marc V. — 5★ — 0 photos {%- endcomment -%}
      <div class="review-card soft-shadow">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <img src="{{ 'soufflo-8C-avatar-marc.jpg' | asset_url }}" alt="Marc V." width="40" height="40" loading="lazy" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;">
