{%- comment -%}
  ============================================================
  Reviews Section — Soufflo Ventilateur Plafonnier LED E27
  ID: "avis" — 6 hardcoded reviews + filter tabs + CTA
  ============================================================
{%- endcomment -%}

<section id="avis" class="py-16 md:py-20" style="background: var(--color-muted);">
