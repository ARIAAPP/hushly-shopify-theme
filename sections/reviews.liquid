</section>

{%- comment -%} Filter tab interaction {%- endcomment -%}
<script>
(function() {
  var tabs = document.querySelectorAll('.review-filter-tab');
  var reviews = document.querySelectorAll('[data-review]');
  if (!tabs.length) return;

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) {
        t.style.background = 'var(--color-bg)';
        t.style.color = 'var(--color-fg)';
        t.classList.remove('is-active');
      });
      tab.style.background = 'var(--color-primary)';
      tab.style.color = 'var(--color-primary-fg)';
      tab.classList.add('is-active');

      var filter = tab.dataset.filter;
      reviews.forEach(function(r) {
        if (filter === 'all' || filter === 'photo') {
          r.style.display = '';
        } else {
          r.style.display = (r.dataset.stars === filter) ? '' : 'none';
        }
      });
    });
  });
})();
</script>

