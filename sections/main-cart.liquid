{%- comment -%}
  Main Cart section — fallback cart page
{%- endcomment -%}

<section class="section" style="text-align:center;">
  <div class="container" style="max-width: 640px;">
    <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--color-fg);">Votre panier</h1>

    {%- if cart.item_count == 0 -%}
      <p style="color: var(--color-muted-fg); margin-bottom: 2rem;">Votre panier est vide.</p>
      <a class="btn btn-primary" href="{{ routes.root_url }}">Continuer mes achats</a>

    {%- else -%}
      <div style="margin-bottom: 2rem;">
        {%- for item in cart.items -%}
          <div style="display: flex; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--color-border);">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 80 }}" alt="{{ item.title | escape }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius);">
            {%- endif -%}
            <div style="flex: 1; text-align: left;">
              <p style="font-weight: 600; margin-bottom: 4px;">{{ item.title }}</p>
              <p style="color: var(--color-muted-fg); font-size: 14px;">Qte : {{ item.quantity }} — {{ item.final_line_price | money }}</p>
            </div>
            <a href="/cart/change?id={{ item.key }}&quantity=0" style="color: var(--color-muted-fg); font-size: 13px; text-decoration: underline;">Retirer</a>
          </div>
        {%- endfor -%}
      </div>

      <div style="margin-bottom: 1.5rem; padding: 16px; background: var(--color-muted); border-radius: var(--radius);">
        <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 600;">
          <span>Sous-total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p style="color: var(--color-muted-fg); font-size: 13px; margin-top: 8px;">Livraison et taxes calculees a l'etape suivante.</p>
      </div>

      <a class="btn btn-accent" href="/checkout" style="width: 100%; font-size: 1.1rem; padding: 16px 28px;">Passer commande</a>
      <a href="{{ routes.root_url }}" style="display: block; margin-top: 1rem; color: var(--color-muted-fg); text-decoration: underline; font-size: 14px;">Continuer mes achats</a>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if ({{ cart.item_count }} > 0 && window.SouffloCart) {
      window.SouffloCart.open();
    }
  });
</script>

{% schema %}
{
  "name": "Panier",
  "tag": "section",
  "class": "main-cart-section",
  "settings": []
}
{% endschema %}
