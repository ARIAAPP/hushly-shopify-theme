<section id="how" class="how-it-works section-padding">
  <div class="container">

    <h2 class="section-title" style="color:#0C4A6E;">Installation en 10 secondes. Vraiment.</h2>
    <p class="section-subtitle">Pas de travaux, pas d'électricien, pas de fil. Juste une douille E27.</p>

    <div class="how-it-works__grid">

      <!-- Step 1 -->
      <div class="hiw-card glow-hover" style="position:relative;">
        <div class="hiw-card__step" style="position:absolute;left:50%;transform:translateX(-50%);top:-1rem;">1</div>
        <div style="font-size:2.5rem;margin-top:1.5rem;margin-bottom:0.75rem;">💡</div>
        <h3 class="hiw-card__title">Dévissez</h3>
        <p class="hiw-card__text">Retirez l'ampoule de n'importe quelle douille E27 standard.</p>
      </div>

      <!-- Step 2 -->
      <div class="hiw-card glow-hover" style="position:relative;">
        <div class="hiw-card__step" style="position:absolute;left:50%;transform:translateX(-50%);top:-1rem;">2</div>
        <div style="font-size:2.5rem;margin-top:1.5rem;margin-bottom:0.75rem;">🔩</div>
        <h3 class="hiw-card__title">Vissez</h3>
        <p class="hiw-card__text">Vissez le Soufflo à la place, exactement comme une ampoule classique.</p>
      </div>

      <!-- Step 3 -->
      <div class="hiw-card glow-hover" style="position:relative;">
        <div class="hiw-card__step" style="position:absolute;left:50%;transform:translateX(-50%);top:-1rem;">3</div>
        <div style="font-size:2.5rem;margin-top:1.5rem;margin-bottom:0.75rem;">🎛️</div>
        <h3 class="hiw-card__title">Profitez</h3>
        <p class="hiw-card__text">Réglez la lumière et la ventilation depuis votre canapé.</p>
      </div>

    </div>

    <!-- Demo video -->
    <div style="margin-top:3rem;border-radius:16px;overflow:hidden;background:#0C4A6E;">
      <video src="{{ 'soufflo-demo-installation.mp4' | asset_url }}" controls playsinline preload="metadata" poster="{{ 'soufflo-6B-installation-10s.jpg' | asset_url }}" style="width:100%;display:block;border-radius:16px;"></video>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comment ça marche",
  "settings": [],
  "presets": [{ "name": "Comment ça marche" }]
}
{% endschema %}
