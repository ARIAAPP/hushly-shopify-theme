<section class="section-padding" style="background:#fff;">
  <div class="container" style="max-width:56rem;">
    <h2 class="section-title" style="color:#0C4A6E;">Soufflo vs les alternatives</h2>
    <p class="section-subtitle">On compare, vous d&eacute;cidez.</p>

    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Crit&egrave;re</th>
            <th class="highlighted">&#x2713; Soufflo</th>
            <th>Climatiseur</th>
            <th>Ventilo plafond</th>
            <th>Ventilo sur pied</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight:500;">Installation</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">10 secondes</td>
            <td style="color:var(--color-muted-fg);">Pro + travaux</td>
            <td style="color:var(--color-muted-fg);">&Eacute;lectricien requis</td>
            <td style="color:var(--color-muted-fg);">Aucune</td>
          </tr>
          <tr>
            <td style="font-weight:500;">Encombrement</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">Z&eacute;ro (au plafond)</td>
            <td style="color:var(--color-muted-fg);">Bloc mural + unit&eacute; ext.</td>
            <td style="color:var(--color-muted-fg);">Z&eacute;ro</td>
            <td style="color:var(--color-muted-fg);">Prend de la place</td>
          </tr>
          <tr>
            <td style="font-weight:500;">&Eacute;clairage int&eacute;gr&eacute;</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">LED 3 couleurs</td>
            <td style="color:var(--color-muted-fg);">Non</td>
            <td style="color:var(--color-muted-fg);">Parfois</td>
            <td style="color:var(--color-muted-fg);">Non</td>
          </tr>
          <tr>
            <td style="font-weight:500;">T&eacute;l&eacute;commande</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">Incluse</td>
            <td style="color:var(--color-muted-fg);">Incluse</td>
            <td style="color:var(--color-muted-fg);">En option (30-50 &euro;)</td>
            <td style="color:var(--color-muted-fg);">Rarement</td>
          </tr>
          <tr>
            <td style="font-weight:500;">Bruit</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">Ultra silencieux</td>
            <td style="color:var(--color-muted-fg);">Variable</td>
            <td style="color:var(--color-muted-fg);">Variable</td>
            <td style="color:var(--color-muted-fg);">Souvent bruyant</td>
          </tr>
          <tr>
            <td style="font-weight:500;">Consommation &eacute;lectrique</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">Minime</td>
            <td style="color:var(--color-muted-fg);">Tr&egrave;s &eacute;lev&eacute;e</td>
            <td style="color:var(--color-muted-fg);">Faible</td>
            <td style="color:var(--color-muted-fg);">Mod&eacute;r&eacute;e</td>
          </tr>
          <tr>
            <td style="font-weight:500;">Prix</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">34,90 &euro;</td>
            <td style="color:var(--color-muted-fg);">300-800 &euro; + pose</td>
            <td style="color:var(--color-muted-fg);">150-400 &euro; + pose</td>
            <td style="color:var(--color-muted-fg);">30-80 &euro;</td>
          </tr>
          <tr>
            <td style="font-weight:500;">Design</td>
            <td class="highlighted-col" style="font-weight:600;color:#0C4A6E;">Discret &amp; moderne</td>
            <td style="color:var(--color-muted-fg);">Bloc imposant</td>
            <td style="color:var(--color-muted-fg);">Imposant</td>
            <td style="color:var(--color-muted-fg);">Encombrant</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="text-center" style="margin-top:2.5rem;">
      <a href="/#product" class="cta-glow">Je veux mon Soufflo &rarr;</a>
    </div>
  </div>
</section>

