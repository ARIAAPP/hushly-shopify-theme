<section class="comparison-section py-16 md:py-24">
  <div class="container" style="max-width: 900px;">
    <div class="text-center" style="margin-bottom: 2.5rem;">
      <h2 class="text-3xl md:text-4xl font-bold" style="margin-bottom: 0.75rem;">{{ section.settings.title }}</h2>
      <p class="text-muted-foreground">{{ section.settings.subtitle }}</p>
    </div>

    {%- comment -%} Desktop table {%- endcomment -%}
    <div class="comparison-desktop" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
      <table class="comparison-table" style="width: 100%; border-collapse: separate; border-spacing: 0; min-width: 600px;">
        <thead>
          <tr>
            <th class="cmp-header-cell" style="text-align: left; padding: 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-muted-foreground, #6b7280); border-bottom: 2px solid var(--color-border);"></th>
            <th class="cmp-header-cell cmp-col-highlight" style="text-align: center; padding: 1rem; font-size: 0.95rem; font-weight: 800; border-bottom: 2px solid var(--color-primary, #0B0F1E); background: var(--color-primary, #0B0F1E); color: var(--color-primary-fg, #fff); border-radius: 12px 12px 0 0;">
              {{ section.settings.col_a }}
            </th>
            <th class="cmp-header-cell" style="text-align: center; padding: 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-muted-foreground, #6b7280); border-bottom: 2px solid var(--color-border);">
              {{ section.settings.col_b }}
            </th>
            <th class="cmp-header-cell" style="text-align: center; padding: 1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-muted-foreground, #6b7280); border-bottom: 2px solid var(--color-border);">
              {{ section.settings.col_c }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="padding: 0.875rem 1rem; font-size: 0.875rem; font-weight: 600; border-bottom: 1px solid var(--color-border);">
                {{ block.settings.criteria }}
              </td>
              <td class="cmp-col-highlight-body" style="text-align: center; padding: 0.875rem 1rem; font-size: 0.875rem; font-weight: 600; border-bottom: 1px solid var(--color-border); background: rgba(11, 15, 30, 0.04);">
                {{ block.settings.val_a }}
              </td>
              <td style="text-align: center; padding: 0.875rem 1rem; font-size: 0.875rem; color: var(--color-muted-foreground, #6b7280); border-bottom: 1px solid var(--color-border);">
                {{ block.settings.val_b }}
              </td>
              <td style="text-align: center; padding: 0.875rem 1rem; font-size: 0.875rem; color: var(--color-muted-foreground, #6b7280); border-bottom: 1px solid var(--color-border);">
                {{ block.settings.val_c }}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- comment -%} Mobile card (Hushly only) {%- endcomment -%}
    <div class="comparison-mobile">
      <div class="rounded-2xl border overflow-hidden" style="border-color: var(--color-border);">
        <div style="background: var(--color-primary, #0B0F1E); color: var(--color-primary-fg, #fff); padding: 1rem 1.25rem; text-align: center;">
          <p class="text-lg font-bold">{{ section.settings.col_a }}</p>
        </div>
        <div class="bg-background">
          {%- for block in section.blocks -%}
            <div class="flex items-center justify-between" style="padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--color-border);" {{ block.shopify_attributes }}>
              <span class="text-sm font-medium">{{ block.settings.criteria }}</span>
              <span class="text-sm font-bold" style="color: var(--color-primary, #0B0F1E);">{{ block.settings.val_a }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="{{ section.settings.cta_url }}" class="btn btn-lg">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .comparison-mobile {
    display: none;
  }
  @media (max-width: 767px) {
    .comparison-desktop {
      display: none;
    }
    .comparison-mobile {
      display: block;
    }
  }
  .comparison-table tr:last-child td {
    border-bottom: none;
  }
  .comparison-table tbody tr {
    transition: background 0.15s ease;
  }
  .comparison-table tbody tr:hover {
    background: var(--color-muted);
  }
  .comparison-table tbody tr:hover .cmp-col-highlight-body {
    background: rgba(11, 15, 30, 0.08);
  }
</style>

{% schema %}
{
  "name": "Tableau comparatif",
  "tag": "section",
  "class": "comparison-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Hushly vs les alternatives"
