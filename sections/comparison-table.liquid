            "val_a": "Zero",
            "val_b": "Zero",
            "val_c": "Au sol"
          }
        },
        {
          "type": "row",
          "settings": {
            "criteria": "Eclairage",
            "val_a": "LED dimmable 3 couleurs",
            "val_b": "Parfois",
            "val_c": "Non"
          }
        },
        {
          "type": "row",
          "settings": {
            "criteria": "Telecommande",
            "val_a": "Incluse",
            "val_b": "Option 30-50€",
            "val_c": "Rarement"
          }
        },
        {
