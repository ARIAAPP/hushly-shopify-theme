    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "On compare, vous decidez."
    },
    {
      "type": "text",
      "id": "col_a",
      "label": "Colonne A (highlight)",
      "default": "Hushly"
    },
    {
      "type": "text",
      "id": "col_b",
