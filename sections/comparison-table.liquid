      "default": "Ventilo plafond"
    },
    {
      "type": "text",
      "id": "col_c",
      "label": "Colonne C",
      "default": "Ventilo sur pied"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton CTA",
      "default": "Je veux mon Hushly"
    },
    {
      "type": "text",
      "id": "cta_url",
