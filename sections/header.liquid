<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="header__brand" aria-label="{{ settings.brand_text | default: 'Hushly' }} — accueil">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: settings.logo_max_width | image_tag: loading: 'lazy' }}
      {%- else -%}
        <span class="header__brand-text">Hushly</span>
      {%- endif -%}
    </a>

    <nav class="header__nav">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <button class="header__cart-btn" data-cart-open aria-label="Panier">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
        <span class="header__cart-count" data-cart-count style="display:none">0</span>
      </button>
      <a href="#product-hero" class="header__cta">Commander</a>
      <button class="header__menu-btn" data-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon-menu><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <nav class="header__mobile-nav" data-mobile-nav style="display:none">
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_link' -%}
        <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "header-section",
  "settings": [],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Lien navigation",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Lien" },
        { "type": "url", "id": "url", "label": "URL", "default": "#" }
      ]
    }
  ],
  "presets": [
    {
      "name": "En-tête",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Le produit", "url": "#product-hero" } },
        { "type": "nav_link", "settings": { "label": "Comment ça marche", "url": "#how" } },
        { "type": "nav_link", "settings": { "label": "Avis clients", "url": "#avis" } },
        { "type": "nav_link", "settings": { "label": "FAQ", "url": "#faq" } },
        { "type": "nav_link", "settings": { "label": "Contact", "url": "#contact" } }
      ]
    }
  ]
}
{% endschema %}
