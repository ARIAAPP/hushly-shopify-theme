<section class="section-padding bg-surface">
  <div class="container">

    <div style="max-width:42rem;margin-left:auto;margin-right:auto;">
      <h2 class="section-title" style="color:#0C4A6E;">Pourquoi tout le monde en parle.</h2>
      <p class="section-subtitle">Tout ce qu'un ventilateur classique fait — sans les inconvénients.</p>
    </div>

    <div class="features__grid">

      <!-- 1 — Installation -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-6B-installation-10s.jpg' | asset_url }}" alt="Installation 10 secondes" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">Z&eacute;ro travaux</h3>
        <p class="feature-card__text">Pas de per&ccedil;age, pas d'&eacute;lectricien, pas de fil.</p>
      </div>

      <!-- 2 — Silence -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-6C-silence-brushless.jpg' | asset_url }}" alt="Moteur brushless silencieux" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">Ultra silencieux</h3>
        <p class="feature-card__text">Profitez du frais sans le bruit.</p>
      </div>

      <!-- 3 — LED -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-6A-3-temperatures.jpg' | asset_url }}" alt="3 temp&eacute;ratures de couleur" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">LED 3 ambiances</h3>
        <p class="feature-card__text">Chaud, naturel ou froid selon l'humeur.</p>
      </div>

      <!-- 4 — T&eacute;l&eacute;commande -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-6D-telecommande-infographie.jpg' | asset_url }}" alt="T&eacute;l&eacute;commande incluse" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">T&eacute;l&eacute;commande</h3>
        <p class="feature-card__text">Lumi&egrave;re et ventilation depuis le canap&eacute;.</p>
      </div>

      <!-- 5 — Puissance -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-5B-apres-soufflo-installe.jpg' | asset_url }}" alt="Soufflo install&eacute; au plafond" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">30W puissant</h3>
        <p class="feature-card__text">&Eacute;clairage LED qui remplace votre ampoule.</p>
      </div>

      <!-- 6 — Universel -->
      <div class="feature-card glow-hover" style="text-align:center;">
        <img src="{{ 'soufflo-5A-avant-ampoule-nue.jpg' | asset_url }}" alt="Compatible douille E27" width="120" height="120" loading="lazy" style="width:120px;height:120px;border-radius:1rem;object-fit:cover;margin:0 auto 0.75rem;">
        <h3 class="feature-card__title" style="color:#0C4A6E;">Compatible universel</h3>
        <p class="feature-card__text">Toute douille E27, 110-240V.</p>
      </div>

    </div>

    <div style="text-align:center;margin-top:2.5rem;">
      <a href="#product" class="cta-glow">Je veux le mien</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pourquoi Soufflo",
  "settings": [],
  "presets": [{ "name": "Pourquoi Soufflo" }]
}
{% endschema %}
