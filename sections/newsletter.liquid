{%- comment -%}
  ============================================================
  Newsletter Signup — Hushly
  Sky blue background (#38BDF8), "5 EUR offerts" hook
  ============================================================
{%- endcomment -%}

<section class="newsletter-block" style="background: var(--color-primary); padding: 3.5rem 0;">
  <div class="max-w-md text-center space-y-4 px-6" style="margin-left: auto; margin-right: auto;">

    <h3 class="text-2xl font-bold" style="color: var(--color-primary-fg);">{{ section.settings.title }}</h3>
    <p class="text-sm" style="color: color-mix(in srgb, var(--color-primary-fg) 80%, transparent);">{{ section.settings.subtitle }}</p>

    {%- form 'customer', class: 'space-y-3', data-newsletter-form: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        required
        placeholder="{{ section.settings.placeholder }}"
        aria-label="Adresse email"
        autocomplete="email"
        style="background: color-mix(in srgb, var(--color-primary-fg) 15%, transparent); border: 1px solid color-mix(in srgb, var(--color-primary-fg) 30%, transparent); color: var(--color-primary-fg); border-radius: var(--radius); padding: 0.85rem 1rem; width: 100%; font-size: 0.95rem;"
      >
      <button type="submit" class="btn btn-block" style="background: var(--color-primary-fg); color: var(--color-primary); font-weight: 700;">
        {{ section.settings.button_label }}
      </button>

      {%- if form.posted_successfully? -%}
        <p class="text-sm font-medium" style="color: var(--color-primary-fg);">{{ section.settings.success_message }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="text-xs" style="color: color-mix(in srgb, var(--color-primary-fg) 55%, transparent);">{{ section.settings.gdpr_note }}</p>

  </div>
</section>

<script>
(function() {
  var form = document.querySelector('[data-newsletter-form]');
  if (!form) return;
  form.addEventListener('submit', function() {
    if (window.fbq) {
      window.fbq('track', 'Lead', {
        content_name: 'newsletter_signup',
        content_category: 'newsletter',
        currency: 'EUR',
        value: 0
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "5€ offerts sur votre 1ère commande"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Inscrivez-vous et recevez votre code par email."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder email",
      "default": "votre@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Recevoir mon code"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message succès",
      "default": "Merci ! Vérifiez votre boîte mail."
    },
    {
      "type": "text",
      "id": "gdpr_note",
      "label": "Note RGPD",
      "default": "En vous inscrivant vous acceptez notre politique de confidentialité."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
