<section class="newsletter-block-primary section-padding">
  <div class="container" style="max-width: 42rem; text-align: center;">

    <h3 class="text-2xl md:text-4xl font-extrabold" style="color: #fff;">5 &euro; offerts sur votre 1&egrave;re commande</h3>
    <p class="text-sm" style="color: rgba(255,255,255,0.9); margin-top: 0.75rem;">Inscrivez-vous et votre code s'affiche imm&eacute;diatement. Valable d&egrave;s 50&nbsp;&euro; d'achat.</p>

    {%- form 'customer', class: 'newsletter-form', data-newsletter-form: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="margin-top: 1.5rem; max-width: 28rem; margin-left: auto; margin-right: auto; display: flex; flex-direction: column; gap: 0.5rem;">
        <div class="newsletter-form__row" style="display: flex; flex-direction: column; gap: 0.5rem;">
          <input
            type="email"
            name="contact[email]"
            required
            placeholder="votre@email.com"
            aria-label="Adresse email"
            autocomplete="email"
            style="background: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: 9999px; padding: 0.75rem 1.25rem; flex: 1; font-size: 0.875rem; color: #1a1a1a; outline: none;"
          >
          <button type="submit" class="newsletter-submit-btn" style="background: #fff; color: #0C4A6E; border-radius: 9999px; padding: 0.75rem 1.5rem; font-weight: 700; font-size: 0.875rem; border: none; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease;">Recevoir mon code</button>
        </div>
      </div>

      {%- if form.posted_successfully? -%}
        {%- comment -%} Code affiche direct : aucun email automatique n'est envoye par la boutique. {%- endcomment -%}
        <div style="margin-top: 1.25rem;">
          <p class="text-sm font-bold" style="color: #fff;">Merci&nbsp;! Voici votre code&nbsp;:</p>
          <div style="display: inline-block; margin-top: 0.75rem; background: #fff; color: #0C4A6E; border-radius: 0.5rem; padding: 0.75rem 1.5rem; font-weight: 800; font-size: 1.25rem; letter-spacing: 0.08em;">BIENVENUE5</div>
          <p class="text-sm" style="color: rgba(255,255,255,0.9); margin-top: 0.75rem;">5&nbsp;&euro; de r&eacute;duction d&egrave;s 50&nbsp;&euro; d'achat &mdash; &agrave; saisir au moment du paiement.</p>
        </div>
      {%- endif -%}
    {%- endform -%}

    <p style="font-size: 10px; color: rgba(255,255,255,0.7); margin-top: 0.75rem;">En vous inscrivant vous acceptez notre politique de confidentialit&eacute;.</p>

  </div>
</section>

<style>
  @media (min-width: 640px) {
    .newsletter-form__row {
      flex-direction: row !important;
    }
  }
  .newsletter-submit-btn:hover {
    background-color: #0C4A6E !important;
    color: #fff !important;
  }
</style>

<script>
(function() {
  var form = document.querySelector('[data-newsletter-form]');
  if (!form) return;
  form.addEventListener('submit', function() {
    if (window.fbq) {
      window.fbq('track', 'Lead', {
        content_name: 'newsletter_signup',
        content_category: 'newsletter',
        currency: 'EUR',
        value: 0
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Newsletter",
  "settings": [],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
